# Copy to .env.local on this computer. Never commit real values.
SUPABASE_URL=
# Server-only sb_secret_ key, or legacy service_role JWT. Never a publishable key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APPLICATIONS_ENABLED=false
ALLOWED_ORIGINS=http://localhost:4174
CONSENT_VERSION=2026-09-07-v1
# Random value of at least 32 characters, generated locally; never exposed to browsers.
RATE_LIMIT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local fake-data testing only. Edge Functions never allow this bypass.
ALLOW_LOCAL_TEST_SUBMISSIONS=false
